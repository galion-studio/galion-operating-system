# G.A.L.I.O.N. hygiene: secrets, audio, models, build output, OS junk
.env
.env.*
!.env.example
*.pem
*.key
*.wav
*.mp3
*.flac
*.ogg
# Synthesised session tones. Not recordings.
!desktop/boot/sounds/boot.wav
!desktop/boot/sounds/boot.ogg
!desktop/boot/sounds/shutdown.wav
!desktop/boot/sounds/shutdown.ogg
!desktop/boot/sounds/wake.wav
!desktop/boot/sounds/wake.ogg
# Supplied startup sound. Not a voice recording.
!desktop/boot/sounds/galion-os-startup.mp3
!desktop/boot/sounds/galion-os-startup.ogg
# Same tones, copied into the brand archive. Not voice.
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/boot.wav
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/boot.ogg
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/shutdown.wav
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/shutdown.ogg
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/wake.wav
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/wake.ogg
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/galion-os-startup.mp3
!docs/brand/archive/galion-operating-system/desktop/boot/sounds/galion-os-startup.ogg
