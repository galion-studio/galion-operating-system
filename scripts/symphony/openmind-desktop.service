# Symphony install. The Pi 5 seed from obsidian-open-mind pull request 100
# ships the openmind-desktop binary and no systemd unit.
[Unit]
Description=Obsidian Open Mind desktop (loopback 127.0.0.1:18181)
After=local-fs.target

[Service]
Type=simple
User=galion
Group=galion
ExecStart=/opt/galion/openmind-desktop/openmind-desktop --listen 127.0.0.1:18181 --stack off
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
