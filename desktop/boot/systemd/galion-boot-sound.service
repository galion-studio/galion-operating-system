#
# One boot chord when the graphical session starts, one shutdown chord
# when it stops. @BIN@ is replaced with the installed script path.
# GALION_BOOT_SOUND=wake selects the 160 ms 432 Hz desktop clip instead.

[Unit]
Description=Galion session boot and shutdown tones
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@BIN@ start
ExecStop=@BIN@ stop

[Install]
WantedBy=graphical-session.target
